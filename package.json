{
  "name": "roughness",
  "version": "0.2.0",
  "description": "A Vue component library with hand-drawn appearance",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepack": "vite build",
    "release": "release-it",
    "docs:dev": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "lint:script": "eslint --cache --fix './**/*.{cjs,js,ts,vue}'",
    "lint:style": "stylelint --ignore-path .gitignore --cache --fix ./**/*.{css,vue}",
    "lint": "pnpm run lint:script && pnpm run lint:style",
    "lint:ci": "eslint --max-warnings 0 './**/*.{cjs,js,ts,vue}' && stylelint --ignore-path .gitignore --max-warnings 0 ./**/*.{css,vue}",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/roughness.git"
  },
  "keywords": [
    "component",
    "rough",
    "vue"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CyanSalt/roughness/issues"
  },
  "homepage": "https://github.com/CyanSalt/roughness#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@babel/types": "7.29.0",
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/stylelint-config": "^4.4.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.3",
    "@types/parse-unit": "^1.0.3",
    "@types/to-px": "^1.1.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue-macros/common": "3.1.2",
    "@vue/language-core": "^3.2.8",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "colord": "^2.9.3",
    "eslint": "^10.3.0",
    "fast-glob": "^3.3.3",
    "lodash-es": "^4.18.1",
    "lucide": "^1.14.0",
    "parse-unit": "^1.0.1",
    "release-it": "^20.0.1",
    "roughjs": "^4.6.6",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.11.0",
    "to-px": "^1.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5",
    "vue": "^3.5.34"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  }
}
